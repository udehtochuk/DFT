# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
